#!/usr/bin/plymouth

# ORIZON Plymouth Boot Theme — чёрный фон, белый лого по центру, Powered by freeSOF снизу

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

# Белый лого по центру
logo_image = Image("orizon-logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth()  / 2 - logo_image.GetWidth()  / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2 - 30);
logo_sprite.SetOpacity(1);

# Прогресс-бар тонкий под лого
bar_width  = 200;
bar_height = 2;
bar_x = Window.GetWidth()  / 2 - bar_width / 2;
bar_y = Window.GetHeight() / 2 + logo_image.GetHeight() / 2 + 16;

progress = 0.0;
bar_fg_sprite = Sprite();
bar_fg_sprite.SetX(bar_x);
bar_fg_sprite.SetY(bar_y);

fun refresh_callback() {
    progress = Math.Min(progress + 0.006, 1.0);
    bar_w = Math.Int(bar_width * progress);
    if (bar_w >= 1) {
        bar_image = Image(bar_w, bar_height);
        bar_fg_sprite.SetImage(bar_image);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# "Powered by freeSOF" внизу по центру
powered_image = Image.Text("Powered by freeSOF", 0.6, 0.6, 0.6, 0.7, "Ubuntu 10");
powered_sprite = Sprite(powered_image);
powered_sprite.SetX(Window.GetWidth()  / 2 - powered_image.GetWidth()  / 2);
powered_sprite.SetY(Window.GetHeight() - 36);
